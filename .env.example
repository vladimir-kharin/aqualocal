# ============================================================================
#  AquaLocal — конфигурация. Скопируй в .env и подставь свои значения.
#  .env в .gitignore, .env.example — публичный шаблон.
#  Правила: без кавычек, обратные слэши в путях НЕ экранируются, пробелы
#  по краям значения обрезаются.
# ============================================================================

# ---------------------------------------------------------------- SingularityApp (задача)
# Токен REST API. Создаётся в ЛК: https://me.singularity-app.com/rest-tokens
# Нужны права на запись: Проект, Задача, Заметка, Тег.
SNG_TOKEN=

SNG_BASE_URL=https://api.singularity-app.com

# ID проекта по умолчанию (P-...). Пусто = задача уходит во «Входящие».
SNG_DEFAULT_PROJECT=

# Порог fuzzy-совпадения имени проекта/тега (0-100). Ниже порога проект/тег
# не проставляется, а причина уходит в описание задачи.
SNG_FUZZY_THRESHOLD=75

# Формат поля note: plain | delta.
# plain — проверено на живом API. delta из спеки не работает: попадает в
# описание задачи как сырой JSON {"ops":[...]}. Не менять без причины.
SNG_NOTE_FORMAT=plain

SNG_TIMEOUT=10
SNG_CACHE_TTL=600

# ---------------------------------------------------------------- Obsidian (заметка/дубль задачи)
# Папка, куда ложатся файлы дня. Если не задать — приложение возьмёт путь по
# умолчанию из кода и напишет предупреждение в лог (заметки не потеряются).
OBS_INBOX_DIR=E:\vaults\personnel\personnel\Входящие

# Имя файла дня и метка времени в строке (синтаксис strftime).
OBS_DATE_FMT=%Y-%m-%d
OBS_TIME_FMT=%H:%M

# Шаблон строки. \t в значении превращается в табуляцию. Плейсхолдеры:
# {time} — время, {text} — распознанный текст. Теги дописываются в конец сами.
OBS_LINE_FMT=- {time}\t{text}

# Заголовок при создании нового файла дня. Пусто = без заголовка.
OBS_HEADING=# {date}

# Сверять имя тега с кэшем тегов SingularityApp (1) или писать как услышалось (0).
OBS_RESOLVE_TAGS=1

# Тег, которым помечается дубль задачи в дневнике (режим "задача" пишет и в
# Singularity, и строкой в Obsidian — чтобы задача не пропала, если API лежит).
OBS_TASK_TAG=задача

# ---------------------------------------------------------------- Горячие клавиши
# Задаются в синтаксисе пакета keyboard. Работают как одиночные клавиши, так и
# комбинации с модификаторами. Регистр значения неважен.
#
#   Одиночные:     f19   f20   f21   f13   pause   scroll lock
#   С модификатором: ctrl+d   alt+shift+1   ctrl+alt+space   win+j
#   Модификаторы:  ctrl  alt  shift  win   (можно несколько через +)
#
# Клавишу удерживаешь — идёт запись, отпускаешь — распознавание и действие.
# Комбинация: держишь всё сочетание, отпускаешь любую клавишу — стоп.
#
# Осторожно с системными и общеупотребимыми сочетаниями (ctrl+c, ctrl+v,
# alt+tab, win+d) — приложение перехватит их глобально во всех программах.
# F13–F24 удобны тем, что их обычно нет на клавиатуре и ничего не ломают
# (шлются, например, макро-клавишами или AutoHotkey).
#
# Если строку не задать — берётся значение по умолчанию (F19/F20/F21).

# Вставить распознанный текст в позицию курсора:
HOTKEY_INSERT=f19

# Отправить задачу в SingularityApp (+ дубль строкой в Obsidian):
HOTKEY_TASK=f20

# Записать заметку строкой в файл дня Obsidian:
HOTKEY_NOTE=f21


# ============================================================================
#  ЛОКАЛЬНЫЙ STT-СЕРВЕР (необязательно)
# ============================================================================
# Позволяет другим программам на этой же машине распознавать звук той моделью,
# что уже загружена в видеопамять: POST http://127.0.0.1:<порт>/stt, тело —
# байты аудиофайла (ogg/opus, mp3, wav — что понимает PyAV), ответ — JSON
# {"text": "..."}. Речи в записи нет → text пустой, модель не запускается.
#
# Слушает только 127.0.0.1, наружу не выставляется. Пусто или строки нет —
# сервер не поднимается вовсе (поведение по умолчанию).

STT_PORT=
